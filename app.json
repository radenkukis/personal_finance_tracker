{
  "expo": {
    "name": "Arta",
    "slug": "arta-finance",
    "scheme": "arta",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0A0D12",
    "splash": {
      "backgroundColor": "#0A0D12",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arta.finance",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Arta memakai mikrofon agar kamu bisa mencatat transaksi dengan berbicara."
      }
    },
    "android": {
      "package": "com.arta.finance",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A0D12"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Arta memakai mikrofon agar kamu bisa mencatat transaksi dengan berbicara."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
