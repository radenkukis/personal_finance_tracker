# =====================================================================
#  Salin file ini menjadi .env  lalu isi nilainya.
#  File .env TIDAK boleh di-commit.
# =====================================================================

# --- Supabase ---------------------------------------------------------
# Ambil dari: Supabase Dashboard > Project Settings > Data API
# Anon key AMAN berada di aplikasi: aksesnya dibatasi Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Mode AI ----------------------------------------------------------
# local  = gratis 100%, parser regex di HP, tanpa API key apa pun
# remote = memanggil Supabase Edge Function (yang menyimpan API key)
EXPO_PUBLIC_AI_MODE=local


# =====================================================================
#  BERIKUT INI *TIDAK* MASUK KE FILE .env DI ATAS.
#  Ini disimpan sebagai Secret di Supabase Edge Function, supaya API key
#  tidak pernah ikut terpasang di dalam aplikasi HP.
#
#    supabase secrets set LLM_PROVIDER=gemini GEMINI_API_KEY=xxx
#
#  LLM_PROVIDER   : local | gemini | claude
#  STT_PROVIDER   : off | gemini | groq
# =====================================================================
