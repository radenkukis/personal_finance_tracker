{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // @types/jest tidak ikut terbaca otomatis di setup ini, jadi disebut eksplisit.
    "types": ["jest"],
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "supabase/functions"]
}
